@startuml core_data_flow

' ============================================
' BPE 核心数据流
' 一条记录从 new_data 到回调的完整路径
' ============================================

skinparam activityShape八角形
skinparam ArrowColor #666666

|#FFE8CC 数据入口|
start
:new_data(&U8Bytes);
if (check_id_in_store(id)) then (id 未定义)
  :log::warn + return false|
else (id 已定义)
endif

|#CCE5FF 存储层|
:find_or_insert_array(id)
→ 懒创建 WrappedArray (环形缓冲);

:insert(array, data)
→ write_data(base = (walker & mask)*step)
→ walker += step;

|#E6FFCC 执行层|
:call_mapper(array, record_id);

if (search_mapper(record_id) 存在?) then (否)
  :return  (无 mapper 或 id 不匹配);
else (是)
endif

:loop_filter 窗口扫描
→ idx: last_idx → first_idx
→ position = ((walker-1-idx)*step) & mask
→ filter.call(sub_data_ptr);  ← JIT 过滤 (LLVM);

if (JIT filter 返回 true?) then (是)
  :mapper.fetch 提取字段
  → Executor 求值 (Const/Fetch/Compute)
  → 写入 PTR_VAL_DATA_REF 缓冲;
  :n += 1;
  if (n == limit?) then (是)
    :break 提前退出;
  else (否)
  endif
else (否)
endif

repeat while (idx 未到 first_idx) is (继续)

|#FFD9E6 回调层|
:callback(FnHolder, CallbackParams{u8_ptr, size, ...});

if (FnHolder::Lambda 且绑定聚合?) then (是)
  :call_aggregate(wrapped, param);
  :init_data 初始化聚合缓冲 (仅 MaxL/MinL/MaxD/MinD);
  :compute_data 逐条聚合 (sum/count/avg/min/max/first/last);
  :callback(FnHolder, CallbackParams{聚合缓冲, size=1});
else (普通回调 / FFI 回调)
  :Rust 闭包 / Java 回调 / Python 回调;
endif

stop

@enduml
